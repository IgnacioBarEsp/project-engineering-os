{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-os.local/schema/config.schema.json",
  "title": "Installed project constructor configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "codeIndexable",
    "activeProfiles",
    "harnesses",
    "githubMode",
    "branchStrategy"
  ],
  "properties": {
    "toolchainRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*[\\\\:\\u0000-\\u001f\\u007f])(?!.*(?:^|/)(?:\\.\\.?|\\.[gG][iI][tT]|\\.[pP][rR][oO][jJ][eE][cC][tT]-[cC][oO][nN][sS][tT][rR][uU][cC][tT][oO][rR])(?:/|$))(?!.*//)(?!.*[. ](?:/|$))(?!.*?/$).+$"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "stage": {
      "const": "environment-bootstrap"
    },
    "codeIndexable": {
      "type": "boolean"
    },
    "activeProfiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "documentation",
          "harness-tooling",
          "ui",
          "backend-api",
          "auth-security",
          "data-migration-sync",
          "ai",
          "infra-deploy",
          "library-cli"
        ]
      }
    },
    "harnesses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "codex",
          "claude-code",
          "cursor",
          "opencode",
          "github-copilot"
        ]
      }
    },
    "githubMode": {
      "enum": [
        "dry-run",
        "read-only"
      ]
    },
    "branchStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "defaultBranch",
        "protectedBranches",
        "changeBranchPrefix"
      ],
      "properties": {
        "status": {
          "const": "manual-pending"
        },
        "defaultBranch": {
          "type": "null"
        },
        "protectedBranches": {
          "type": "array",
          "maxItems": 0
        },
        "changeBranchPrefix": {
          "type": "null"
        }
      }
    }
  }
}
