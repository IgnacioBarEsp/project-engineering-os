{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-os.local/schema/onboarding-state.schema.json",
  "title": "Project Engineering OS canonical onboarding state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stateFormatVersion",
    "schemaVersion",
    "classifierVersion",
    "route",
    "decisionStatus",
    "rebootstrapAllowed",
    "evidence",
    "answers",
    "pendingQuestions",
    "deferredDecisions",
    "nextSteps",
    "inputHash"
  ],
  "properties": {
    "stateFormatVersion": {
      "const": 1
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "classifierVersion": {
      "const": "1.0.0"
    },
    "route": {
      "enum": [
        "beginner",
        "experienced-new",
        "brownfield"
      ]
    },
    "decisionStatus": {
      "enum": [
        "confirmed",
        "provisional"
      ]
    },
    "rebootstrapAllowed": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "answers": {
      "$ref": "#/$defs/answers"
    },
    "pendingQuestions": {
      "$ref": "#/$defs/questionIds"
    },
    "deferredDecisions": {
      "$ref": "#/$defs/questionIds"
    },
    "nextSteps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "questionId": {
      "enum": [
        "project",
        "guidance",
        "tracker",
        "agent",
        "remoteSetup"
      ]
    },
    "questionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/questionId"
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "guidance",
        "tracker",
        "agent",
        "remoteSetup"
      ],
      "properties": {
        "project": {
          "enum": [
            "new",
            "preserve",
            "unknown",
            "defer"
          ]
        },
        "guidance": {
          "enum": [
            "guided",
            "brief",
            "unknown",
            "defer"
          ]
        },
        "tracker": {
          "enum": [
            "existing",
            "github-projects",
            "azure-boards",
            "jira",
            "other",
            "none",
            "unknown",
            "defer"
          ]
        },
        "agent": {
          "enum": [
            "claude",
            "codex",
            "cursor",
            "copilot",
            "opencode",
            "other",
            "unknown",
            "defer"
          ]
        },
        "remoteSetup": {
          "enum": [
            "local-only",
            "review-later",
            "unknown",
            "defer"
          ]
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "preservation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "category": {
          "enum": [
            "automation",
            "content",
            "git",
            "harness",
            "inspection",
            "remote",
            "tracker"
          ]
        },
        "preservation": {
          "type": "boolean"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    }
  }
}
