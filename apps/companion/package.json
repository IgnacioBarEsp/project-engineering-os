{
  "name": "@project-engineering-os/companion",
  "version": "0.1.0",
  "description": "Prepara carpetas de proyecto y su contexto para trabajar con la IA que ya usas, sin terminal.",
  "author": {
    "name": "Ignacio Barboza Espinoza"
  },
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "start": "electron .",
    "runtime:install": "node node_modules/electron/install.js",
    "test:ui": "node scripts/verify-ui.mjs",
    "test": "node --test qa/*.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "pack": "node scripts/pack-app.mjs",
    "pack:verify": "node scripts/verify-app-artifact.mjs",
    "evidence:journeys": "node scripts/verify-journeys.mjs",
    "evidence:native": "node scripts/verify-native-journeys.mjs",
    "evidence:launches": "node scripts/verify-local-launches.mjs",
    "evidence:model": "node scripts/verify-model-benchmark.mjs",
    "evidence:benchmark": "node scripts/verify-benchmark.mjs",
    "evidence:landing": "node scripts/verify-landing.mjs"
  },
  "dependencies": {
    "create-project-engineering-os": "0.5.0",
    "fflate": "0.8.3",
    "npm": "11.19.1",
    "pdfjs-dist": "6.3.289",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2",
    "playwright": "1.62.1"
  }
}
