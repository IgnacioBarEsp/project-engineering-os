+// En español el imperativo de los verbos en -ar coincide con el presente de
+// indicativo («completa la verificación» es prosa, no una orden de plantilla),
+// así que el verbo por sí solo no distingue una instrucción sin rellenar. Lo
+// que sí la distingue es que el complemento señale a la propia plantilla:
+// «sustituye este bloque», «reemplaza aquí», «rellena con tu valor».
+const TEMPLATE_FILL_VERB_ES = '(?:reemplaz(?:a|á|ar|e)|sustitu(?:ye|yé|ya|ir)'
+  + '|complet(?:a|á|ar|e)|rellen(?:a|á|ar|e))';
+const TEMPLATE_NOUN_ES = '(?:texto|bloque|campo|valor|marcador|ejemplo|placeholder'
+  + '|secci[oó]n|l[ií]nea|plantilla|apartado|fragmento|contenido|cadena)s?';
+// `\b` de JavaScript solo conoce [A-Za-z0-9_], así que no cierra palabra
+// después de una vocal acentuada («aquí»). El fin de palabra se comprueba con
