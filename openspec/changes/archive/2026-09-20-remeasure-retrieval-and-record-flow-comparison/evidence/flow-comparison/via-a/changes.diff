+  + `|con\\s+(?:tu|su|el|la|un|una)\\s+${TEMPLATE_NOUN_ES}${WORD_END}`
+  + `|(?:el|la|los|las)\\s+(?:placeholder|marcador|plantilla)s?${WORD_END}`
+  + ')',
+  'iu',
+);
